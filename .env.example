# Copiar a ".env.local" (no se sube a git) y completar con valores reales.
# En Vercel estas mismas variables se cargan desde el panel del proyecto.

# Supabase (Project Settings > API en el dashboard de Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SOLO se usa en el servidor (Route Handlers), nunca se expone al browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (lectura + extraccion estructurada, un solo llamado).
# Se consigue gratis en https://aistudio.google.com > Get API key.
GEMINI_API_KEY=

# Clave para firmar la cookie de sesion propia (si no se usa Supabase Auth directamente).
# Generar una propia en produccion, por ejemplo con: openssl rand -hex 32
SESSION_SECRET=
